{
  "compilerOptions": {
    // Environment
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",

    // React
    "jsx": "react-jsx",

    // Strict mode
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Output
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Module behavior
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,

    // 🔥 IMPORTANT (SHADCN FIX)
    "baseUrl": ".",
    "paths": {
      "@/*": ["resources/js/*"]
    }
  }
}